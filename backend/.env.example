# Copy to .env and adjust. All keys are prefixed with VMAX_.
VMAX_ENVIRONMENT=development
VMAX_REQUEST_TIMEOUT=12
VMAX_MAX_CONCURRENCY=20
VMAX_PORT_SCAN_ENABLED=true
VMAX_REQUIRE_VERIFIED_TARGET=true
VMAX_CORS_ORIGINS=["http://localhost:3000"]

# Supabase persistence (optional). Leave blank to use the in-memory store.
VMAX_SUPABASE_URL=
VMAX_SUPABASE_SERVICE_KEY=
VMAX_SUPABASE_JWT_SECRET=
VMAX_AUTH_REQUIRED=false
